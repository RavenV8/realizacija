/* Bendras dėžutės stilius su sumažintu plotu ir aukščiu */
#registration-container {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 50px;
    width: 100%;
}

.registration {
    width: 60%; /* Sumažinome plotį, kad tilptų į ekraną */
    padding: 20px;
    background-color: #f9f9f9;
    border-radius: 8px;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    border: 1px solid #ddd;
    box-sizing: border-box;
}

.registration h3 {
    text-align: center;
    margin-bottom: 20px;
}

/* Formos eilutės, kad būtų galima pasiskirstyti stulpeliais */
.form-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
    width: 100%;
}

/* Kiekvienas stulpelis */
.form-column {
    display: flex;
    flex-direction: column;
    gap: 10px; /* Tarpo tarp etikečių ir įvesties laukelių */
    flex-basis: 48%; /* Kiekvienas stulpelis bus 48% pločio */
}

/* Įvesties laukelių bendri stiliai su padidintu aukščiu ir padding */
input[type="text"],
input[type="email"],
input[type="tel"],
input[type="password"] {
    padding: 16px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 16px;
    width: 100%; /* Užims visą pločio vietą */
    height: 50px; /* Padidintas aukštis */
    box-sizing: border-box;
}

/* Registracijos mygtuko stilius */
button {
    padding: 16px;
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    width: 100%;  /* Mygtukas užims visą plotį */
}

button:hover {
    background-color: #45a049;
}

/* Nuorodos stilius */
a {
    display: block;
    margin-top: 15px;
    text-align: center;
    color: #007BFF;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}
